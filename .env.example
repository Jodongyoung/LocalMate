# LocalMate example configuration. Copy to backend/.env ONLY after backend implementation is ready.
# Never put real secrets in Git or frontend VITE_* variables.
APP_ENV=development
APP_NAME=LocalMate
DATABASE_URL=sqlite:///./localmate.db
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true

# Development mode: use deterministic mock provider until an authorized, free endpoint is configured.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Configure a local secret only if/when backend auth requires one.
AUTH_SECRET_KEY=
